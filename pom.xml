<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.cresco</groupId>
        <artifactId>cresco-parent</artifactId>
        <version>1.3-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <artifactId>wsapi</artifactId>

    <name>Cresco WSAPI</name>
    <description>Cresco framework websocket API</description>
    <url>https://github.com/CrescoEdge/wsapi</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>

    <scm>
        <connection>scm:git:git://github.com/CrescoEdge/wsapi.git</connection>
        <developerConnection>scm:git:git://github.com/CrescoEdge/wsapi.git</developerConnection>
        <url>git@github.com:CrescoEdge/wsapi.git</url>
    </scm>

    <properties>
        <!-- jdk, encoding, plugin & OSGi API / gson versions inherited from cresco-parent -->
        <!-- Rebuilt on Jetty 12 (jakarta.servlet 6 / jakarta.websocket 2). Jetty 9.4 was EOL. -->
        <jetty.version>12.1.10</jetty.version>
        <!-- Netty WebSocket transport (replacing Jetty). -->
        <netty.version>4.2.15.Final</netty.version>
        <bouncycastle.version>1.78.1</bouncycastle.version>
    </properties>

    <dependencies>

        <!-- OSGi R8 API versions managed by cresco-parent; build-time only -> provided -->
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.annotation</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.metatype.annotations</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.cm</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Cresco SPI (provides jakarta.jms, guava, etc. at runtime) -->
        <dependency>
            <groupId>io.cresco</groupId>
            <artifactId>library</artifactId>
            <version>1.3-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <!-- SLF4J: bootstrap-window fallback logger. Provided (the framework exports SLF4J 2.x via
             Pax Logging); previously came in transitively through Jetty, now declared explicitly. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- Self-signed TLS keystore/cert generation for the wss connector (mints the
             identity-carrying cert). bcpkix (Java 8+ "jdk18on" build) pulls bcprov + bcutil
             transitively; the JDK has no public API to create an X.509 cert. -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- Netty WebSocket server (replaces Jetty 12). netty-codec-http = HTTP/1.1 + WebSocket
             handlers; netty-handler = SslHandler. Pure-NIO transport, OSGi-embeddable. -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http</artifactId>
            <version>${netty.version}</version>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
            <version>${netty.version}</version>
        </dependency>

        <!-- Native OpenSSL/BoringSSL TLS provider (netty-tcnative). The JDK SSLEngine is ~2-3x
             slower than native for bulk crypto and is the single-stream dataplane ceiling. Enabled
             only when wsapi_ssl_provider=OPENSSL AND the native lib loads; otherwise the code falls
             back to the JDK provider, so this dep is inert by default. Static jar embeds the native
             lib (extracted from the bundle classpath at runtime). classifier is host-arch specific. -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-tcnative-boringssl-static</artifactId>
            <version>2.0.72.Final</version>
            <classifier>osx-aarch_64</classifier>
        </dependency>

    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>.idea/**</exclude>
                    <exclude>node_modules/**</exclude>
                    <exclude>mock-server.js</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>

            <!-- maven-compiler-plugin (release 21) inherited from cresco-parent -->

            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <!-- version + extensions inherited from cresco-parent pluginManagement -->
                <configuration>
                    <instructions>
                        <Bundle-SymbolicName>${project.groupId}.${project.artifactId}</Bundle-SymbolicName>
                        <Bundle-Name>WSAPI Plugin</Bundle-Name>
                        <Bundle-Description>The Cresco websocket API</Bundle-Description>
                        <Bundle-Vendor>Cresco.io</Bundle-Vendor>
                        <Bundle-Version>${project.version}-${maven.build.timestamp}</Bundle-Version>
                        <!-- Real BundleActivator: sets JVM system properties at start. -->
                        <Bundle-Activator>io.cresco.wsapi.Activator</Bundle-Activator>
                        <!-- Cresco SPI + framework + Config Admin are hard requirements; embedded Jetty/BC stay optional. -->
                        <Import-Package>
                            org.osgi.framework,
                            org.osgi.framework.*,
                            org.osgi.service.cm,
                            io.cresco.library.*,
                            *;resolution:=optional
                        </Import-Package>
                        <!-- Self-contained: embed the full Jetty 12 closure + jakarta.servlet/websocket
                             + BouncyCastle. Embed-Transitive is required because Jetty pulls its modules
                             (jetty-util/http/io, jakarta.websocket/servlet-api) transitively. slf4j-api is
                             NOT embedded: the framework exports SLF4J 2.x (Pax Logging 2.x), so Jetty's
                             logging binds to the framework's log4j2 and lands in main.log.
                             scope=compile|runtime keeps provided (OSGi, library) jars out. -->
                        <Embed-Transitive>true</Embed-Transitive>
                        <Embed-Dependency>!org.osgi.*;!osgi.cmpn.*;!library;!slf4j-api;*;scope=compile|runtime</Embed-Dependency>
                    </instructions>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <profiles>
        <profile>
            <id>allow-snapshots</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <repositories>
                <repository>
                    <id>snapshots-repo</id>
                    <url>https://central.sonatype.com/repository/maven-snapshots</url>
                    <releases><enabled>false</enabled></releases>
                    <snapshots><enabled>true</enabled></snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

</project>
